{
  "name": "countingdown",
  "version": "1.2.1",
  "private": true,
  "description": "倒数日 CountingDown",
  "main": "./out/main/index.js",
  "author": "CountingDown",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "art": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-installer-art.ps1",
    "dist": "electron-vite build && electron-builder --win --x64 --dir && node scripts/build-installer.cjs",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "dist:nsis": "electron-vite build && electron-builder --win --x64",
    "installer": "node scripts/build-installer.cjs",
    "doctor": "node scripts/update-doctor.cjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "element-plus": "^2.9.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.countingdown.widget",
    "productName": "倒数日",
    "copyright": "Copyright © 2026 CountingDown",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "executableName": "CountingDown",
      "legalTrademarks": "CountingDown"
    },
    "nsis": {
      "artifactName": "CountingDown_Setup_${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "倒数日",
      "menuCategory": false,
      "uninstallDisplayName": "倒数日",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "installerHeader": "resources/installerHeader.bmp",
      "installerSidebar": "resources/installerSidebar.bmp",
      "uninstallerSidebar": "resources/installerSidebar.bmp",
      "include": "installer.nsh",
      "language": "2052"
    }
  }
}
