# ---------------------------------------------------------------- 依赖与包管理
node_modules/
.pnpm-store/
.pnpm-cache/

# ---------------------------------------------------------------- 构建产物
out/
dist/
.vite/
*.tsbuildinfo
release/

# ---------------------------------------------------------------- 自写安装器（C#）
# bin/ 是 dotnet build 的输出（cd-setup.exe 在这里），obj/ 是还原与中间缓存，
# 两者都由 `npm run dist` 重新生成，没有一行需要进版本库。
installer/bin/
installer/obj/
*.user
*.suo

# ---------------------------------------------------------------- 测试与验证产物
# 截图、日志、payload.zip、端到端临时目录都落在这两个目录里
.verify/
.probe-userdata/

# ---------------------------------------------------------------- 日志与系统垃圾
*.log
npm-debug.log*
yarn-error.log*
Thumbs.db
Desktop.ini
*.tmp

# ---------------------------------------------------------------- 编辑器
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------- 本地环境变量
.env
.env.*
!.env.example

# ---------------------------------------------------------------- 本地笔记
.workbuddy/
docs/superpowers
